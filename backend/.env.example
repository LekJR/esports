PORT=3000

# Railway MySQL usually provides MYSQL_URL. Keep DB_* values for local MySQL.
MYSQL_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE
# DATABASE_URL and MYSQL_PUBLIC_URL are also supported.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=esports_reminders

# Comma-separated origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080
